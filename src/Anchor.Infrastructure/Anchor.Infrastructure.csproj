<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Anchor.Core\Anchor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\browser\anchor-page-agent\focus-engine.js" LogicalName="Anchor.Infrastructure.Browser.focus-engine.js" />
    <EmbeddedResource Include="..\..\browser\anchor-page-agent\page-agent.js" LogicalName="Anchor.Infrastructure.Browser.page-agent.js" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\contracts\anchor.proto" GrpcServices="Client" Link="Contracts\anchor.proto" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
