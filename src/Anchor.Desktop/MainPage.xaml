<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Anchor_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Padding" Value="22" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Metric" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Persistent status strip: always shows what Anchor is doing right now. -->
        <Border Padding="24,14" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Padding="12,7" CornerRadius="14" Background="#227C9CFF" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" Fill="#7C9CFF" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.AttentionState, Mode=OneWay}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.Confidence, Mode=OneWay}" Foreground="#AFC1FF" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.CurrentSubtask, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
                <ProgressRing Grid.Column="2" Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                    <Button Content="I'm distracted" Command="{x:Bind ViewModel.ReportDistractedCommand}" ToolTipService.ToolTip="Ctrl+Shift+F12" />
                    <Button Content="Release overlays (Esc)" Command="{x:Bind ViewModel.EmergencyReleaseCommand}" ToolTipService.ToolTip="Clears every overlay and pointer restriction immediately" />
                </StackPanel>
            </Grid>
        </Border>

        <NavigationView x:Name="Sections" Grid.Row="1" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" SelectionChanged="Sections_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="FocusItem" Content="Focus" Tag="Focus" Icon="Target" />
                <NavigationViewItem Content="Tools" Tag="Tools" Icon="View" />
                <NavigationViewItem Content="Camera" Tag="Camera" Icon="Camera" />
                <NavigationViewItem Content="Insights" Tag="Insights" Icon="Clock" />
                <NavigationViewItem Content="Settings" Tag="Settings" Icon="Setting" />
            </NavigationView.MenuItems>

            <Grid>
                <!-- FOCUS: goal, plan, progress, live estimate -->
                <ScrollViewer x:Name="FocusSection">
                    <Grid MaxWidth="1100" Padding="28,20,28,32" ColumnSpacing="20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="16">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="What are you working on?" Style="{StaticResource CardTitle}" />
                                    <TextBox Text="{x:Bind ViewModel.TaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="e.g. do 3 USACO problems, read chapter 4, write the intro paragraph" FontSize="17" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Content="Plan goal" Command="{x:Bind ViewModel.PlanGoalCommand}" Style="{StaticResource AccentButtonStyle}" />
                                        <Button Content="Start focus session" Command="{x:Bind ViewModel.StartCommand}" IsEnabled="{x:Bind ViewModel.IsPlanReady, Mode=OneWay}" />
                                        <Button Content="Stop session" Command="{x:Bind ViewModel.StopCommand}" IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.CapabilityStatus, Mode=OneWay}" Style="{StaticResource Hint}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Plan" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="{x:Bind ViewModel.PlanSource, Mode=OneWay}" Style="{StaticResource Hint}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Padding="12,6" CornerRadius="12" Background="#332E5CFF" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.TaskProgressLabel, Mode=OneWay}" Foreground="#AFC1FF" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <Border Padding="14" CornerRadius="12" Background="#241C2941">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Current step" Style="{StaticResource Hint}" />
                                            <TextBlock Text="{x:Bind ViewModel.CurrentSubtask, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBox Text="{x:Bind ViewModel.ProgressNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         PlaceholderText="Log progress, e.g. 'solved 2021 Dec Bronze problem 1'" />
                                                <Button Grid.Column="1" Content="Log progress" Command="{x:Bind ViewModel.LogProgressCommand}" />
                                                <Button Grid.Column="2" Content="Step done" Command="{x:Bind ViewModel.MarkCurrentStepCompleteCommand}" Style="{StaticResource AccentButtonStyle}" />
                                            </Grid>
                                            <TextBlock Text="Progress is detected automatically from the screen; typing a note is optional."
                                                       Style="{StaticResource Hint}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="14" CornerRadius="12" Background="#2A2E4A6B" BorderBrush="#4D6FA0FF" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Screen monitor" Style="{StaticResource Hint}" />
                                            <TextBlock Text="{x:Bind ViewModel.ScreenProgressStatus, Mode=OneWay}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ViewModel.ScreenAnchor, Mode=OneWay}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ViewModel.ScreenReaderStatus, Mode=OneWay}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <InfoBar IsOpen="{x:Bind ViewModel.HasPendingSuggestion, Mode=OneWay}" IsClosable="False" Severity="Success"
                                             Title="Progress spotted on screen" Message="{x:Bind ViewModel.PendingSuggestion, Mode=OneWay}">
                                        <InfoBar.Content>
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                                                <Button Content="Yes, mark done" Command="{x:Bind ViewModel.ConfirmSuggestionCommand}" Style="{StaticResource AccentButtonStyle}" />
                                                <Button Content="Not yet" Command="{x:Bind ViewModel.DismissSuggestionCommand}" />
                                            </StackPanel>
                                        </InfoBar.Content>
                                    </InfoBar>
                                    <InfoBar IsOpen="{x:Bind ViewModel.IsPlanComplete, Mode=OneWay}" IsClosable="False" Severity="Success"
                                             Title="Goal complete" Message="Every step is done. Plan a new goal or stop the session." />
                                    <ListView ItemsSource="{x:Bind ViewModel.TaskSteps, Mode=OneWay}" MaxHeight="260" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="0,6" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Number}" Foreground="#AFC1FF" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding CompletionCriterion}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Status}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="16">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Live attention estimate" Style="{StaticResource CardTitle}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind ViewModel.AttentionState, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Confidence, Mode=OneWay}" FontSize="22" VerticalAlignment="Center" Foreground="#AFC1FF" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind ViewModel.ReasonSummary, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Evidence: foreground window, task relevance, typing and pointer rhythm, scrolling, idle time, gaze (when a camera runs), and your own reports."
                                               Style="{StaticResource Hint}" />
                                    <ToggleSwitch Header="Treat the current window as task-relevant"
                                                  OffContent="Model judgment" OnContent="Marked relevant"
                                                  IsOn="{x:Bind ViewModel.TreatCurrentWindowAsRelevant, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardStyle}" Padding="16">
                                    <StackPanel><TextBlock Text="Focused" Style="{StaticResource Hint}" /><TextBlock Text="{x:Bind ViewModel.FocusedDuration, Mode=OneWay}" Style="{StaticResource Metric}" /></StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16">
                                    <StackPanel><TextBlock Text="Interruptions" Style="{StaticResource Hint}" /><TextBlock Text="{x:Bind ViewModel.InterruptionCount, Mode=OneWay}" Style="{StaticResource Metric}" /></StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="What is active right now" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{x:Bind ViewModel.ToolkitStatus, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.BrowserStatus, Mode=OneWay}" Style="{StaticResource Hint}" />
                                    <TextBlock Text="{x:Bind ViewModel.GazeStatusMessage, Mode=OneWay}" Style="{StaticResource Hint}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- TOOLS: browser + desktop interventions -->
                <ScrollViewer x:Name="ToolsSection" Visibility="Collapsed">
                    <Grid MaxWidth="1100" Padding="28,20,28,32" ColumnSpacing="20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="16">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Pictures and pages" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Lowers the resolution of distracting pictures in whatever is in front — web pages, PDFs, Word — while the text stays sharp. No browser extension needed: Anchor captures the front window, finds photo-like regions in the pixels, and paints a coarse, pixelated copy over just those spots so you still see what the picture is, not its details."
                                               Style="{StaticResource Hint}" />
                                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="{x:Bind ViewModel.ImageBlurStatus, Mode=OneWay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ToggleSwitch Header="Blur distracting images" OffContent="Off" OnContent="On" IsOn="{x:Bind ViewModel.BlurImagesEnabled, Mode=TwoWay}" />
                                        <Button Content="Preview blur (20 s)" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                                Command="{x:Bind ViewModel.PreviewToolkitCommand}" CommandParameter="ImageBlur" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.BrowserStatus, Mode=OneWay}" Style="{StaticResource Hint}" />
                                    <ToggleSwitch Header="Hide text ahead of where you are reading" OffContent="Off" OnContent="On" IsOn="{x:Bind ViewModel.HideFutureTextEnabled, Mode=TwoWay}" />
                                    <ToggleSwitch Header="Pause animations and GIFs" OffContent="Off" OnContent="On" IsOn="{x:Bind ViewModel.SuppressAnimationsEnabled, Mode=TwoWay}" />
                                    <TextBlock Text="Optional: load browser\anchor-extension as an unpacked extension (chrome://extensions → Developer mode → Load unpacked) for the two page-text tools above. Password, payment, and non-http pages are never touched."
                                               Style="{StaticResource Hint}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Safety" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Esc releases every overlay and pointer restriction. Ctrl+Shift+A reopens this window. Ctrl+Shift+F12 reports a distraction. Password and secure windows suppress all interventions. Everything fails open."
                                               TextWrapping="Wrap" />
                                    <Button Content="Release overlays now (Esc)" Command="{x:Bind ViewModel.EmergencyReleaseCommand}" />
                                    <ToggleSwitch Header="Reduced motion" OffContent="Animations on" OnContent="Animations minimized" IsOn="{x:Bind ViewModel.ReducedMotion, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Desktop, PDFs, and other apps" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Outside the browser Anchor cannot edit the document, so it works on the screen instead: dimming, shading off-task windows, a gaze spotlight, and check-in cards. Armed tools wait for a focus session and confirmed distraction; use Preview to see each one for 8 seconds."
                                           Style="{StaticResource Hint}" />
                                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="{x:Bind ViewModel.ToolkitStatus, Mode=OneWay}" />
                                <Grid ColumnSpacing="8" RowSpacing="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ToggleSwitch Header="Dim the desktop when distracted" OffContent="Off" OnContent="Armed" IsOn="{x:Bind ViewModel.VisualFilterEnabled, Mode=TwoWay}" />
                                    <Button Grid.Column="1" Content="Preview" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.PreviewToolkitCommand}" CommandParameter="PeripheralDim" />
                                    <ToggleSwitch Grid.Row="1" Header="Shade off-task windows" OffContent="Off" OnContent="Armed" IsOn="{x:Bind ViewModel.WindowFirewallEnabled, Mode=TwoWay}" />
                                    <Button Grid.Row="1" Grid.Column="1" Content="Preview" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.PreviewToolkitCommand}" CommandParameter="WindowFirewall" />
                                    <ToggleSwitch Grid.Row="2" Header="Gaze spotlight (needs a live camera)" OffContent="Off" OnContent="Armed" IsOn="{x:Bind ViewModel.GazeSpotlightEnabled, Mode=TwoWay}" />
                                    <Button Grid.Row="2" Grid.Column="1" Content="Preview" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.PreviewToolkitCommand}" CommandParameter="GazeSpotlight" />
                                    <ToggleSwitch Grid.Row="3" Header="Pointer guard (keeps the cursor in the task window)" OffContent="Off" OnContent="Armed" IsOn="{x:Bind ViewModel.PointerGuardEnabled, Mode=TwoWay}" />
                                    <Button Grid.Row="3" Grid.Column="1" Content="Preview" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.PreviewToolkitCommand}" CommandParameter="PointerGuard" />
                                    <ToggleSwitch Grid.Row="4" Header="Audio shield" OffContent="Off" OnContent="On" IsOn="{x:Bind ViewModel.AudioShieldEnabled, Mode=TwoWay}" />
                                    <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Spacing="4" Margin="0,8,0,0">
                                        <TextBlock Text="Check-ins (always on during a session)" FontWeight="SemiBold" />
                                        <TextBlock Text="Beacon pulse when drifting, intention gate when distracted, context reminder when you come back." Style="{StaticResource Hint}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Preview beacon" Command="{x:Bind ViewModel.PreviewBeaconCommand}" />
                                            <Button Content="Test shake" Command="{x:Bind ViewModel.TestBeaconShakeCommand}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Preview intention gate" Command="{x:Bind ViewModel.PreviewToolkitCommand}" CommandParameter="IntentionGate" />
                                            <Button Content="Preview reminder" Command="{x:Bind ViewModel.PreviewToolkitCommand}" CommandParameter="ContextReminder" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- CAMERA: discovery, gaze test, calibration -->
                <ScrollViewer x:Name="CameraSection" Visibility="Collapsed">
                    <Grid MaxWidth="1100" Padding="28,20,28,32" ColumnSpacing="20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Camera and gaze" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Frames stay on this PC and are turned into gaze coordinates only. No video is stored." Style="{StaticResource Hint}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Find cameras" Command="{x:Bind ViewModel.RefreshCamerasCommand}" Style="{StaticResource AccentButtonStyle}" />
                                    <Button Content="Start gaze test" Command="{x:Bind ViewModel.StartGazeTestCommand}" />
                                    <Button Content="Stop" Command="{x:Bind ViewModel.StopGazeTestCommand}" />
                                </StackPanel>
                                <ComboBox Header="Camera" ItemsSource="{x:Bind ViewModel.CameraDevices, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedCamera, Mode=TwoWay}"
                                          DisplayMemberPath="Name" PlaceholderText="Press Find cameras" HorizontalAlignment="Stretch" />
                                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="{x:Bind ViewModel.GazeStatusMessage, Mode=OneWay}" />
                                <Border Height="240" CornerRadius="12" Background="#FF111722" BorderBrush="#334A5A77" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="Preview appears here while a gaze test runs" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}" />
                                        <Image Source="{x:Bind ViewModel.GazePreviewSource, Mode=OneWay}" Stretch="UniformToFill" />
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Padding="8,5" CornerRadius="8" Background="#CC09101B">
                                            <TextBlock Text="{x:Bind ViewModel.GazeCoordinates, Mode=OneWay}" FontSize="11" />
                                        </Border>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="8,5" CornerRadius="8" Background="#CC09101B">
                                            <TextBlock Text="{x:Bind ViewModel.GazeConfidenceLabel, Mode=OneWay}" Foreground="#AFC1FF" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Padding="12" CornerRadius="12" Background="#241C2941">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Nine-point calibration" FontWeight="SemiBold" />
                                            <TextBlock Text="Look at the named screen position, hold still, then capture." Style="{StaticResource Hint}" />
                                            <TextBlock Text="{x:Bind ViewModel.CalibrationTarget, Mode=OneWay}" FontSize="18" Foreground="#AFC1FF" Margin="0,8,0,0" />
                                            <TextBlock Text="{x:Bind ViewModel.CalibrationProgressLabel, Mode=OneWay}" FontSize="12" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Capture point" VerticalAlignment="Center" Command="{x:Bind ViewModel.CaptureCalibrationPointCommand}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Tuning" Style="{StaticResource CardTitle}" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ToggleSwitch Header="Mirror camera" IsOn="{x:Bind ViewModel.GazeMirror, Mode=TwoWay}" />
                                    <NumberBox Grid.Column="1" Header="Rotation (0 / 90 / 180 / 270)" Minimum="0" Maximum="270" SmallChange="90"
                                               SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.GazeRotationDegrees, Mode=TwoWay}" />
                                </Grid>
                                <Slider Header="Horizontal offset" Minimum="-0.5" Maximum="0.5" StepFrequency="0.01" Value="{x:Bind ViewModel.GazeOffsetX, Mode=TwoWay}" />
                                <Slider Header="Vertical offset" Minimum="-0.5" Maximum="0.5" StepFrequency="0.01" Value="{x:Bind ViewModel.GazeOffsetY, Mode=TwoWay}" />
                                <Slider Header="Smoothing" Minimum="0" Maximum="0.95" StepFrequency="0.05" Value="{x:Bind ViewModel.GazeSmoothing, Mode=TwoWay}" />
                                <Slider Header="Sensitivity" Minimum="0.25" Maximum="3" StepFrequency="0.05" Value="{x:Bind ViewModel.GazeSensitivity, Mode=TwoWay}" />
                                <Slider Header="Minimum confidence" Minimum="0" Maximum="1" StepFrequency="0.05" Value="{x:Bind ViewModel.GazeMinimumConfidence, Mode=TwoWay}" />
                                <Button Content="Apply adjustments" HorizontalAlignment="Left" Command="{x:Bind ViewModel.ApplyGazeSettingsCommand}" />
                                <TextBlock Text="If no camera is listed: check Windows Settings → Privacy → Camera, close other apps using the camera, and make sure the worker runtime (Media Foundation + Visual C++ redistributable) is installed. The status above says which of these failed."
                                           Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- INSIGHTS: timeline, stats, recording -->
                <ScrollViewer x:Name="InsightsSection" Visibility="Collapsed">
                    <Grid MaxWidth="1100" Padding="28,20,28,32" ColumnSpacing="20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardStyle}" Padding="16">
                                    <StackPanel><TextBlock Text="Focused" Style="{StaticResource Hint}" /><TextBlock Text="{x:Bind ViewModel.FocusedDuration, Mode=OneWay}" Style="{StaticResource Metric}" /></StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16">
                                    <StackPanel><TextBlock Text="Interruptions" Style="{StaticResource Hint}" /><TextBlock Text="{x:Bind ViewModel.InterruptionCount, Mode=OneWay}" Style="{StaticResource Metric}" /></StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                                    <StackPanel><TextBlock Text="Recovery time" Style="{StaticResource Hint}" /><TextBlock Text="{x:Bind ViewModel.RecoveryDuration, Mode=OneWay}" Style="{StaticResource Metric}" /></StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Attention analysis" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Computed from this session's timeline: how long you stay on task before drifting, how fast you come back, and what pulls you away." Style="{StaticResource Hint}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Padding="12" CornerRadius="12" Background="#241C2941">
                                            <StackPanel><TextBlock Text="Attention span (median / longest)" Style="{StaticResource Hint}" /><TextBlock Text="{x:Bind ViewModel.Analytics.AttentionSpan, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Padding="12" CornerRadius="12" Background="#241C2941">
                                            <StackPanel><TextBlock Text="Distractions / hour · median recovery" Style="{StaticResource Hint}" /><TextBlock Text="{x:Bind ViewModel.Analytics.DistractionRate, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Padding="12" CornerRadius="12" Background="#241C2941">
                                            <StackPanel><TextBlock Text="Time on task" Style="{StaticResource Hint}" /><TextBlock Text="{x:Bind ViewModel.Analytics.OnTaskShare, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{x:Bind ViewModel.Analytics.Triggers, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.Analytics.Interventions, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.Analytics.Trend, Mode=OneWay}" TextWrapping="Wrap" Foreground="#AFC1FF" />
                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <TextBlock Text="Session timeline" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="State changes, interventions, progress you logged, and evidence Anchor spotted." Style="{StaticResource Hint}" />
                                    <ListView ItemsSource="{x:Bind ViewModel.Timeline, Mode=OneWay}" MaxHeight="420" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="0,7" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Time}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Study recording" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Record screen + gaze locally to compare sessions with and without Anchor" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Padding="10,6" CornerRadius="12" Background="#332E5CFF">
                                        <TextBlock Text="{x:Bind ViewModel.RecordingElapsed, Mode=OneWay}" Foreground="#AFC1FF" />
                                    </Border>
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Participant code" Text="{x:Bind ViewModel.ParticipantCode, Mode=TwoWay}" PlaceholderText="P01 (pseudonym only)" />
                                    <ComboBox Grid.Column="1" Header="Trial mode" SelectedIndex="{x:Bind ViewModel.RecordingModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Baseline · interventions off" />
                                        <ComboBoxItem Content="Anchor enabled" />
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Output folder" Text="{x:Bind ViewModel.RecordingOutputFolder, Mode=TwoWay}" />
                                    <Button Grid.Column="1" Content="Choose…" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.ChooseRecordingFolderCommand}" />
                                </Grid>
                                <ToggleSwitch Header="Include webcam thumbnail" IsOn="{x:Bind ViewModel.WebcamRecordingConsent, Mode=TwoWay}"
                                              IsEnabled="False" OffContent="Unavailable in this release" />
                                <TextBlock Text="Display 1 · 15 FPS · audio off · gaze point and task state are composited into the MP4" Style="{StaticResource Hint}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Start recording" Command="{x:Bind ViewModel.StartRecordingCommand}" Style="{StaticResource AccentButtonStyle}" />
                                    <Button Content="Stop" Command="{x:Bind ViewModel.StopRecordingCommand}" />
                                    <Button Content="Open folder" Command="{x:Bind ViewModel.OpenRecordingFolderCommand}" />
                                </StackPanel>
                                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="{x:Bind ViewModel.RecordingStatus, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.LatestRecordingFiles, Mode=OneWay}" Style="{StaticResource Hint}" />
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Button Content="Compare recordings" HorizontalAlignment="Left" Command="{x:Bind ViewModel.CompareRecordingsCommand}" />
                                <TextBlock Text="{x:Bind ViewModel.ComparisonReport, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- SETTINGS: intelligence, privacy -->
                <ScrollViewer x:Name="SettingsSection" Visibility="Collapsed">
                    <Grid MaxWidth="1100" Padding="28,20,28,32" ColumnSpacing="20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="DeepSeek intelligence" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="DeepSeek (deepseek-flash) plans the goal, judges window relevance, decides from on-device OCR text whether the current step is finished, and phrases the 'where you were' reminder for the activity you were doing. It is always on once a key is saved; local rules are only the fallback when there is no key or the API is unreachable, and every fallback result is labelled 'Local rules'. Only bounded, redacted text is sent — never screenshots or the camera feed."
                                           Style="{StaticResource Hint}" />
                                <PasswordBox x:Name="DeepSeekKeyBox" Header="API key" PlaceholderText="sk-… (stored encrypted for this Windows account)"
                                             PasswordChanged="DeepSeekKeyBox_PasswordChanged" />
                                <Button Content="Save API key" HorizontalAlignment="Left" Command="{x:Bind ViewModel.SaveDeepSeekSettingsCommand}" />
                                <TextBlock Text="{x:Bind ViewModel.DeepSeekStatus, Mode=OneWay}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Privacy by design" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="• Raw keystrokes are never stored — only counts and rhythm" TextWrapping="Wrap" />
                                <TextBlock Text="• Window titles are redacted before storage" TextWrapping="Wrap" />
                                <TextBlock Text="• Camera frames become gaze coordinates on-device; no video leaves this PC" TextWrapping="Wrap" />
                                <TextBlock Text="• Password and secure windows suppress interventions" TextWrapping="Wrap" />
                                <TextBlock Text="• All restrictions fail open; Esc always releases" TextWrapping="Wrap" />
                                <Button Content="Delete local history" HorizontalAlignment="Left" Command="{x:Bind ViewModel.DeleteLocalHistoryCommand}" />
                                <TextBlock Text="Anchor is assistive — not diagnostic. It estimates attention from interaction patterns and may be wrong." Style="{StaticResource Hint}" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
