<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Anchor_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <Grid MaxWidth="1180" Padding="32,24,32,40" RowSpacing="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                    <TextBlock Text="Anchor" FontSize="32" FontWeight="SemiBold" />
                    <TextBlock Text="Settings · plan, sense, prevent, recover, and review without leaving your desktop."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Padding="12,7" CornerRadius="16" Background="#227C9CFF">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" Fill="#7C9CFF" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.CapabilityStatus, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Padding="22" CornerRadius="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="7">
                        <TextBlock Text="What are you trying to do?" FontWeight="SemiBold" />
                        <TextBox Text="{x:Bind ViewModel.TaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="A concrete task, not a vague category" FontSize="17" />
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Content="Plan goal" Command="{x:Bind ViewModel.PlanGoalCommand}" Style="{StaticResource AccentButtonStyle}" />
                        <Button Grid.Column="1" Content="Start focus session" Command="{x:Bind ViewModel.StartCommand}" IsEnabled="{x:Bind ViewModel.IsPlanReady, Mode=OneWay}" />
                        <Button Grid.Column="2" Content="Stop" Command="{x:Bind ViewModel.StopCommand}" />
                        <Button Grid.Column="4" Content="I'm distracted" Command="{x:Bind ViewModel.ReportDistractedCommand}" Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                    <Border Grid.Row="2" Padding="14" CornerRadius="12" Background="#241C2941">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Current plan" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.PlanSource, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{x:Bind ViewModel.TaskProgressLabel, Mode=OneWay}" VerticalAlignment="Center" Foreground="#AFC1FF" />
                                    <Button Content="Done with current step" Command="{x:Bind ViewModel.MarkCurrentStepCompleteCommand}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.CurrentSubtask, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <ListView ItemsSource="{x:Bind ViewModel.TaskSteps, Mode=OneWay}" MaxHeight="190">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,5" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Number}" Foreground="#AFC1FF" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding CompletionCriterion}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="16">
                    <Border Padding="22" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="14">
                            <Grid>
                                <TextBlock Text="Live attention estimate" FontSize="19" FontWeight="SemiBold" />
                                <ProgressRing HorizontalAlignment="Right" Width="22" Height="22" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.AttentionState, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Confidence, Mode=OneWay}" FontSize="22" VerticalAlignment="Center" Foreground="#AFC1FF" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.ReasonSummary, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <InfoBar IsOpen="True" Severity="Informational" IsClosable="False" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                            <Button Content="Emergency release (Esc)" HorizontalAlignment="Left" Command="{x:Bind ViewModel.EmergencyReleaseCommand}" />
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Padding="18" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel><TextBlock Text="Focused" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{x:Bind ViewModel.FocusedDuration, Mode=OneWay}" FontSize="24" /></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="18" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel><TextBlock Text="Interruptions" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{x:Bind ViewModel.InterruptionCount, Mode=OneWay}" FontSize="24" /></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="18" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel><TextBlock Text="Recovery time" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{x:Bind ViewModel.RecoveryDuration, Mode=OneWay}" FontSize="24" /></StackPanel>
                        </Border>
                    </Grid>

                    <Border Padding="22" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Attention timeline" FontSize="19" FontWeight="SemiBold" />
                            <ListView ItemsSource="{x:Bind ViewModel.Timeline, Mode=OneWay}" MaxHeight="260">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,7" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Padding="22" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="DeepSeek intelligence" FontSize="19" FontWeight="SemiBold" />
                            <ToggleSwitch Header="Use DeepSeek for task plans and relevance" IsOn="{x:Bind ViewModel.DeepSeekEnabled, Mode=TwoWay}" />
                            <PasswordBox x:Name="DeepSeekKeyBox" Header="API key" PlaceholderText="Stored encrypted for this Windows account"
                                         PasswordChanged="DeepSeekKeyBox_PasswordChanged" />
                            <Button Content="Save DeepSeek settings" HorizontalAlignment="Left" Command="{x:Bind ViewModel.SaveDeepSeekSettingsCommand}" />
                            <ToggleSwitch Header="Treat the current window as task-relevant"
                                          OffContent="Use model judgment" OnContent="User override"
                                          IsOn="{x:Bind ViewModel.TreatCurrentWindowAsRelevant, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind ViewModel.DeepSeekStatus, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="22" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Test Gaze" FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Text="Private local camera test, tuning, and nine-point calibration"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                    <Button Content="Find cameras" Command="{x:Bind ViewModel.RefreshCamerasCommand}" />
                                    <Button Content="Start" Command="{x:Bind ViewModel.StartGazeTestCommand}" Style="{StaticResource AccentButtonStyle}" />
                                    <Button Content="Stop" Command="{x:Bind ViewModel.StopGazeTestCommand}" />
                                </StackPanel>
                            </Grid>
                            <ComboBox Header="Camera" ItemsSource="{x:Bind ViewModel.CameraDevices, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedCamera, Mode=TwoWay}"
                                      DisplayMemberPath="Name" PlaceholderText="Select Find cameras first" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <ToggleSwitch Header="Mirror camera" IsOn="{x:Bind ViewModel.GazeMirror, Mode=TwoWay}" />
                                <NumberBox Grid.Column="1" Header="Rotation (0 / 90 / 180 / 270)" Minimum="0" Maximum="270" SmallChange="90"
                                           SpinButtonPlacementMode="Inline" Value="{x:Bind ViewModel.GazeRotationDegrees, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock Text="Horizontal offset" FontSize="12" />
                            <Slider Minimum="-0.5" Maximum="0.5" StepFrequency="0.01" Value="{x:Bind ViewModel.GazeOffsetX, Mode=TwoWay}" />
                            <TextBlock Text="Vertical offset" FontSize="12" />
                            <Slider Minimum="-0.5" Maximum="0.5" StepFrequency="0.01" Value="{x:Bind ViewModel.GazeOffsetY, Mode=TwoWay}" />
                            <TextBlock Text="Smoothing" FontSize="12" />
                            <Slider Minimum="0" Maximum="0.95" StepFrequency="0.05" Value="{x:Bind ViewModel.GazeSmoothing, Mode=TwoWay}" />
                            <TextBlock Text="Sensitivity" FontSize="12" />
                            <Slider Minimum="0.25" Maximum="3" StepFrequency="0.05" Value="{x:Bind ViewModel.GazeSensitivity, Mode=TwoWay}" />
                            <TextBlock Text="Minimum confidence" FontSize="12" />
                            <Slider Minimum="0" Maximum="1" StepFrequency="0.05" Value="{x:Bind ViewModel.GazeMinimumConfidence, Mode=TwoWay}" />
                            <Button Content="Apply adjustments" HorizontalAlignment="Left" Command="{x:Bind ViewModel.ApplyGazeSettingsCommand}" />
                            <Border Height="190" CornerRadius="12" Background="#FF111722" BorderBrush="#334A5A77" BorderThickness="1">
                                <Grid>
                                    <Image Source="{x:Bind ViewModel.GazePreviewSource, Mode=OneWay}" Stretch="UniformToFill" />
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Padding="8,5" CornerRadius="8" Background="#CC09101B">
                                        <TextBlock Text="{x:Bind ViewModel.GazeCoordinates, Mode=OneWay}" FontSize="11" />
                                    </Border>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="8,5" CornerRadius="8" Background="#CC09101B">
                                        <TextBlock Text="{x:Bind ViewModel.GazeConfidenceLabel, Mode=OneWay}" Foreground="#AFC1FF" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Padding="12" CornerRadius="12" Background="#241C2941">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Nine-point calibration" FontWeight="SemiBold" />
                                        <TextBlock Text="Look at the named screen position and hold still, then capture."
                                                   FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.CalibrationTarget, Mode=OneWay}" FontSize="18" Foreground="#AFC1FF" Margin="0,8,0,0" />
                                        <TextBlock Text="{x:Bind ViewModel.CalibrationProgressLabel, Mode=OneWay}" FontSize="12" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Capture point" VerticalAlignment="Center"
                                            Command="{x:Bind ViewModel.CaptureCalibrationPointCommand}" />
                                </Grid>
                            </Border>
                            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                     Message="{x:Bind ViewModel.GazeStatusMessage, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="22" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Focus toolkit" FontSize="19" FontWeight="SemiBold" />
                            <ToggleSwitch Header="Dynamic image blur" OffContent="Off" OnContent="On" IsOn="{x:Bind ViewModel.BlurImagesEnabled, Mode=TwoWay}" />
                            <ToggleSwitch Header="Hide future text" OffContent="Off" OnContent="On" IsOn="{x:Bind ViewModel.HideFutureTextEnabled, Mode=TwoWay}" />
                            <ToggleSwitch Header="Visual focus filter" OffContent="Off" OnContent="On" IsOn="{x:Bind ViewModel.VisualFilterEnabled, Mode=TwoWay}" />
                            <ToggleSwitch Header="Gaze spotlight" OffContent="Off" OnContent="On" IsOn="{x:Bind ViewModel.GazeSpotlightEnabled, Mode=TwoWay}" />
                            <ToggleSwitch Header="Low-relevance window firewall" OffContent="Off" OnContent="On" IsOn="{x:Bind ViewModel.WindowFirewallEnabled, Mode=TwoWay}" />
                            <ToggleSwitch Header="Pointer guard" OffContent="Off" OnContent="On" IsOn="{x:Bind ViewModel.PointerGuardEnabled, Mode=TwoWay}" />
                            <ToggleSwitch Header="Audio shield" OffContent="Off" OnContent="On" IsOn="{x:Bind ViewModel.AudioShieldEnabled, Mode=TwoWay}" />
                            <ToggleSwitch Header="Reduced motion" OffContent="Off" OnContent="On" IsOn="{x:Bind ViewModel.ReducedMotion, Mode=TwoWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Preview beacon" Command="{x:Bind ViewModel.PreviewBeaconCommand}" />
                                <Button Content="Test attention shake" Command="{x:Bind ViewModel.TestBeaconShakeCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Preview spotlight" Command="{x:Bind ViewModel.PreviewToolkitCommand}" CommandParameter="GazeSpotlight" />
                                <Button Content="Preview dim" Command="{x:Bind ViewModel.PreviewToolkitCommand}" CommandParameter="PeripheralDim" />
                                <Button Content="Preview firewall" Command="{x:Bind ViewModel.PreviewToolkitCommand}" CommandParameter="WindowFirewall" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Preview intention gate" Command="{x:Bind ViewModel.PreviewToolkitCommand}" CommandParameter="IntentionGate" />
                                <Button Content="Preview context reminder" Command="{x:Bind ViewModel.PreviewToolkitCommand}" CommandParameter="ContextReminder" />
                                <Button Content="Preview pointer guard" Command="{x:Bind ViewModel.PreviewToolkitCommand}" CommandParameter="PointerGuard" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.ToolkitStatus, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="22" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Privacy by design" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="• Raw keystrokes are never stored" TextWrapping="Wrap" />
                            <TextBlock Text="• Window context is redacted before storage" TextWrapping="Wrap" />
                            <TextBlock Text="• No screenshot stream leaves this device" TextWrapping="Wrap" />
                            <TextBlock Text="• Password and secure windows suppress interventions" TextWrapping="Wrap" />
                            <TextBlock Text="• All restrictions fail open" TextWrapping="Wrap" />
                            <Button Content="Delete local history" HorizontalAlignment="Left" Command="{x:Bind ViewModel.DeleteLocalHistoryCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="3" Text="Anchor is assistive—not diagnostic. It estimates attention from interaction patterns and may be wrong."
                       HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </ScrollViewer>
</Page>
