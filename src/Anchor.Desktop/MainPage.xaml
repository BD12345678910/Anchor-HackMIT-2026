<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Anchor_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <Grid MaxWidth="1180" Padding="32,24,32,40" RowSpacing="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                    <TextBlock Text="Anchor" FontSize="32" FontWeight="SemiBold" />
                    <TextBlock Text="A quiet, local attention assistant that helps you return—not feel judged."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Padding="12,7" CornerRadius="16" Background="#227C9CFF">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" Fill="#7C9CFF" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.CapabilityStatus, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Padding="22" CornerRadius="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="7">
                        <TextBlock Text="What are you trying to do?" FontWeight="SemiBold" />
                        <TextBox Text="{x:Bind ViewModel.TaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="A concrete task, not a vague category" FontSize="17" />
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Content="Start focus session" Command="{x:Bind ViewModel.StartCommand}" Style="{StaticResource AccentButtonStyle}" />
                        <Button Grid.Column="1" Content="Stop" Command="{x:Bind ViewModel.StopCommand}" />
                        <Button Grid.Column="3" Content="I'm distracted" Command="{x:Bind ViewModel.ReportDistractedCommand}" Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="16">
                    <Border Padding="22" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="14">
                            <Grid>
                                <TextBlock Text="Live attention estimate" FontSize="19" FontWeight="SemiBold" />
                                <ProgressRing HorizontalAlignment="Right" Width="22" Height="22" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.AttentionState, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Confidence, Mode=OneWay}" FontSize="22" VerticalAlignment="Center" Foreground="#AFC1FF" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.ReasonSummary, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <InfoBar IsOpen="True" Severity="Informational" IsClosable="False" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                            <Button Content="Emergency release (Esc)" HorizontalAlignment="Left" Command="{x:Bind ViewModel.EmergencyReleaseCommand}" />
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Padding="18" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel><TextBlock Text="Focused" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{x:Bind ViewModel.FocusedDuration, Mode=OneWay}" FontSize="24" /></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="18" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel><TextBlock Text="Interruptions" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{x:Bind ViewModel.InterruptionCount, Mode=OneWay}" FontSize="24" /></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="18" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel><TextBlock Text="Recovery time" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{x:Bind ViewModel.RecoveryDuration, Mode=OneWay}" FontSize="24" /></StackPanel>
                        </Border>
                    </Grid>

                    <Border Padding="22" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Attention timeline" FontSize="19" FontWeight="SemiBold" />
                            <ListView ItemsSource="{x:Bind ViewModel.Timeline, Mode=OneWay}" MaxHeight="260">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,7" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Padding="22" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Focus toolkit" FontSize="19" FontWeight="SemiBold" />
                            <ToggleSwitch Header="Dynamic image blur" OffContent="Off" OnContent="On" IsOn="{x:Bind ViewModel.BlurImagesEnabled, Mode=TwoWay}" />
                            <ToggleSwitch Header="Hide future text" OffContent="Off" OnContent="On" IsOn="{x:Bind ViewModel.HideFutureTextEnabled, Mode=TwoWay}" />
                            <ToggleSwitch Header="Visual focus filter" OffContent="Off" OnContent="On" IsOn="{x:Bind ViewModel.VisualFilterEnabled, Mode=TwoWay}" />
                            <ToggleSwitch Header="Pointer guard" OffContent="Off" OnContent="On" IsOn="{x:Bind ViewModel.PointerGuardEnabled, Mode=TwoWay}" />
                            <ToggleSwitch Header="Audio shield" OffContent="Off" OnContent="On" IsOn="{x:Bind ViewModel.AudioShieldEnabled, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="22" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Privacy by design" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="• Raw keystrokes are never stored" TextWrapping="Wrap" />
                            <TextBlock Text="• Window context is redacted before storage" TextWrapping="Wrap" />
                            <TextBlock Text="• No screenshot stream leaves this device" TextWrapping="Wrap" />
                            <TextBlock Text="• Password and secure windows suppress interventions" TextWrapping="Wrap" />
                            <TextBlock Text="• All restrictions fail open" TextWrapping="Wrap" />
                            <Button Content="Delete local history" HorizontalAlignment="Left" Command="{x:Bind ViewModel.DeleteLocalHistoryCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="3" Text="Anchor is assistive—not diagnostic. It estimates attention from interaction patterns and may be wrong."
                       HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </ScrollViewer>
</Page>
