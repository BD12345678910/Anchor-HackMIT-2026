<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Anchor_Desktop.Overlays.RecoveryCardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Anchor overlay">
    <Grid Background="#F7182030" Padding="28" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14">
            <TextBlock x:Name="HeadlineText" Text="Let's restore your place" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="ReasonText" Foreground="#9EABC8" TextWrapping="Wrap" />
            <Border Padding="14" Background="#2A2E4A6B" CornerRadius="12" BorderBrush="#4D6FA0FF" BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="ActivityText" FontSize="12" Foreground="#AFC1FF" Text="WHERE YOU WERE" CharacterSpacing="60" />
                    <TextBlock x:Name="WhereText" FontSize="16" TextWrapping="Wrap" Text="Recalling your place…" />
                    <TextBlock x:Name="ResumeText" Foreground="#D2DAEE" TextWrapping="Wrap" />
                    <TextBlock x:Name="ReminderSourceText" FontSize="11" Foreground="#9EABC8" />
                </StackPanel>
            </Border>
            <Border Padding="14" Background="#241C2941" CornerRadius="12">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="TaskText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="SubtaskText" Foreground="#D2DAEE" TextWrapping="Wrap" />
                    <TextBlock x:Name="LastActionText" TextWrapping="Wrap" />
                    <TextBlock x:Name="NextActionText" Foreground="#AFC1FF" TextWrapping="Wrap" />
                    <TextBlock x:Name="EvidenceText" FontSize="12" Foreground="#9EABC8" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="SourceText" Text="Context was preserved locally." FontSize="12" Foreground="#9EABC8" TextWrapping="Wrap" />
        </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
            <Button Content="Dismiss" Click="Dismiss_Click" />
            <Button Content="Take a break" Click="Break_Click" />
            <Button Content="Break down" Click="BreakDown_Click" />
            <Button Content="Recap" Click="Recap_Click" />
            <Button Content="Reopen" Click="Reopen_Click" />
            <Button Content="Resume" Click="Return_Click" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
