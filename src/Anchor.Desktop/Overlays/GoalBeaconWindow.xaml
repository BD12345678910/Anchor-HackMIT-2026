<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Anchor_Desktop.Overlays.GoalBeaconWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="BeaconCard" Margin="8" Padding="18,14" CornerRadius="16"
            Background="#F51D2433" BorderBrush="#587AEF" BorderThickness="1">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse Width="14" Height="14" Fill="#7C9CFF" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="CURRENT INTENTION" FontSize="11" Foreground="#9EABC8" />
                <TextBlock x:Name="TaskText" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
