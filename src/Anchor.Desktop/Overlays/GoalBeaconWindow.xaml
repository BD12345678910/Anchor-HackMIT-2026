<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Anchor_Desktop.Overlays.GoalBeaconWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Anchor overlay">
    <Border x:Name="BeaconCard" Margin="8" Padding="18,12" CornerRadius="16"
            Background="#F51D2433" BorderBrush="#587AEF" BorderThickness="1">
        <Border.RenderTransform>
            <TranslateTransform x:Name="BeaconTranslation" />
        </Border.RenderTransform>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse Width="14" Height="14" Fill="#7C9CFF" VerticalAlignment="Center" />
            <Grid Grid.Column="1" RowSpacing="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="CURRENT STEP" FontSize="11" Foreground="#9EABC8" />
                    <TextBlock x:Name="ProgressText" HorizontalAlignment="Right" FontSize="11" Foreground="#AFC1FF" />
                </Grid>
                <TextBlock Grid.Row="1" x:Name="SubtaskText" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="2" x:Name="GoalText" FontSize="12" Foreground="#9EABC8" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>
    </Border>
</Window>
